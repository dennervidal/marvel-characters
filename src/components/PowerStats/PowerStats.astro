---
import type { Powerstats } from '@/types'

const { powerstats = {} } = Astro.props as { powerstats?: Powerstats }

const STATS: { key: keyof Powerstats; label: string }[] = [
  { key: 'intelligence', label: 'Intelligence' },
  { key: 'strength', label: 'Strength' },
  { key: 'speed', label: 'Speed' },
  { key: 'durability', label: 'Durability' },
  { key: 'power', label: 'Power' },
  { key: 'combat', label: 'Combat' }
]
---

<div class='flex flex-col gap-3'>
  {
    STATS.map(({ key, label }) => {
      const raw = powerstats[key]
      const numeric = Number(raw)
      const width =
        Number.isFinite(numeric) && raw !== '-'
          ? Math.max(0, Math.min(100, numeric))
          : 0
      return (
        <div>
          <div class='mb-1 flex justify-between font-mono text-[0.55rem] uppercase tracking-wide text-muted-foreground'>
            <span>{label}</span>
            <span>{raw && raw !== '-' ? raw : '-'}</span>
          </div>
          <div class='h-3 border-2 border-border bg-white'>
            <div class='h-full bg-primary' style={{ width: `${width}%` }} />
          </div>
        </div>
      )
    })
  }
</div>
